NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google AI Studio API key — used for AI-generated activity suggestions (Gemini 2.0 Flash free tier)
# Get one at https://aistudio.google.com/apikey
GOOGLE_AI_API_KEY=your-google-ai-api-key

# Stripe — used for Plus subscription payments
# Dashboard → Developers → API keys
STRIPE_SECRET_KEY=sk_live_...
# Dashboard → Developers → API keys (publishable)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
# Dashboard → Products → create "ScrapLab Plus" recurring price at $4.99/mo → copy price ID
STRIPE_PLUS_PRICE_ID=price_...
# Dashboard → Developers → Webhooks → add endpoint → copy signing secret
# Webhook URL: https://your-domain.com/api/webhooks/stripe
# Events to listen for: checkout.session.completed, customer.subscription.deleted
STRIPE_WEBHOOK_SECRET=whsec_...

# RevenueCat — Apple In-App Purchase for the iOS app's "ScrapLab Plus"
# subscription (Stripe can't be used for purchases made inside an iOS app).
# RevenueCat dashboard → Project settings → API keys → App Store (public) key
NEXT_PUBLIC_REVENUECAT_IOS_API_KEY=appl_...
# RevenueCat dashboard → Project settings → API keys → secret key
# Used server-side to verify entitlements (api/me/sync-revenuecat)
REVENUECAT_SECRET_API_KEY=sk_...
# RevenueCat dashboard → Integrations → Webhooks → add a webhook, set the
# Authorization header value here, and use the same value below.
# Webhook URL: https://your-domain.com/api/webhooks/revenuecat
REVENUECAT_WEBHOOK_SECRET=...
