default_platform(:ios)

platform :ios do
  desc "Build the native ScrapLab app for CI validation"
  lane :build do
    sh("xcodegen generate --spec project.yml")
    build_app(
      project: "ScrapLab.xcodeproj",
      scheme: "ScrapLab",
      clean: true,
      skip_codesigning: true,
      skip_archive: true
    )
  end

  desc "Build, sign, and upload a TestFlight build. Requires APP_STORE_CONNECT_API_KEY_ID, " \
       "APP_STORE_CONNECT_API_ISSUER_ID, and APP_STORE_CONNECT_API_KEY_FILEPATH (path to the " \
       "decoded .p8) in the environment — see docs/ios-release-checklist.md."
  lane :beta do
    # key_filepath, not key_content+is_key_content_base64 — the latter parses the EC key from
    # an in-memory string and is unreliable when that string comes from a CI secret (recurring
    # "invalid curve name" OpenSSL::PKey::ECError across fastlane/fastlane for years, e.g. #17340).
    # The workflow decodes the base64 secret to a real file before this lane runs.
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("APP_STORE_CONNECT_API_KEY_ID"),
      issuer_id: ENV.fetch("APP_STORE_CONNECT_API_ISSUER_ID"),
      key_filepath: ENV.fetch("APP_STORE_CONNECT_API_KEY_FILEPATH")
    )

    sh("xcodegen generate --spec project.yml")

    # A unique, monotonically increasing build number per CI run — avoids depending on
    # querying App Store Connect for the previous build number, which would fail on the
    # very first upload before any TestFlight build exists yet.
    increment_build_number(
      xcodeproj: "ScrapLab.xcodeproj",
      build_number: ENV.fetch("GITHUB_RUN_NUMBER", Time.now.to_i.to_s)
    )

    build_app(
      project: "ScrapLab.xcodeproj",
      scheme: "ScrapLab",
      clean: true,
      export_method: "app-store",
      # Automatic signing (already the project's CODE_SIGN_STYLE) lets Xcode fetch/create
      # the needed distribution certificate and provisioning profile using the API key —
      # no separately-exported .p12/.mobileprovision secrets to manage or rotate.
      xcargs: "-allowProvisioningUpdates"
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end
end
